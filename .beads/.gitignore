# Database
*.db
*.db-journal
*.db-shm
*.db-wal

# Lock files
*.lock
.write.lock

# Temporary
last-touched
*.tmp

# Local history backups
.br_history/

# DB-family recovery artifacts (truncated WAL/SHM, quarantined sidecars)
# — same lifecycle as .br_history/, written by recovery paths and
# `br doctor --repair`. Filename suffix `.truncated-wal` slips past the
# generic `*.db-wal` glob above, so it needs an explicit entry (#271).
.br_recovery/

# Sync state (local-only, per-machine)
.sync.lock
sync_base.jsonl

# Merge artifacts (temporary files from 3-way merge)
beads.base.jsonl
beads.base.meta.json
beads.left.jsonl
beads.left.meta.json
beads.right.jsonl
beads.right.meta.json

# Daemon runtime files
daemon.lock
daemon.log
daemon.pid
bd.sock
sync-state.json

# Per-machine runtime state upstream never tracks (trackedRuntimePatterns /
# trackedRuntimeDirPrefixes in cmd/bd/doctor/tracked_runtime.go). `backup/` is
# Dolt-native full-DB backup for off-machine recovery — local-only unless
# `backup.git-push` is set, which it is not here.
.local_version
backup/

# Worktree redirect file
redirect

# bv (beads viewer) lock file
.bv.lock

# Local interaction log (per-machine). Records who changed which field and why,
# so it carries operator names and free-text reasons. `br sync --flush-only`
# does not touch it, and no tracked beads file references it — it is local
# telemetry, not shared state.
interactions.jsonl

# Added by bd (missing required patterns)
*.db?*
.env
bd.sock.startlock
*.gate.lock*
export-state/
export-state.json
last_pull
dolt/
embeddeddolt/
proxieddb/
ephemeral.sqlite3
dolt-server.pid
dolt-server.log
dolt-server.lock
dolt-server.port
dolt-server.activity
daemon.*
*.corrupt.backup/
.beads-credential-key
proxied_server_client_info.json
