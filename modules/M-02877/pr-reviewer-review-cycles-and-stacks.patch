+        assert_eq!(
+            final_verdict(rc, &[(Warning, Inline)]),
+            ReviewVerdict::Comment
+        );
+        assert_eq!(final_verdict(rc, &[(Blocking, StillOpen)]), rc);
+        assert_eq!(
+            final_verdict(ReviewVerdict::Comment, &[(Blocking, Inline)]),
+            ReviewVerdict::Comment,
