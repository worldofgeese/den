+        );
+        assert!(body.contains("Fixed or likely addressed: 1"), "{body}");
+    }
+    assert_eq!(
+        *gh.dismissed.lock().unwrap(),
+        vec!["/repos/o/r/pulls/7/reviews/100/dismissals".to_string()],
