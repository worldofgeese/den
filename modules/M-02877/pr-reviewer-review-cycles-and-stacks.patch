+            fingerprint: finding_key(path, Some(line), body),
+            path: path.to_string(),
+            line: Some(line),
+            body: body.to_string(),
+            evidence_note: None,
+            severity,
+            finding_kind: FindingKind::Correctness,
+            kind,
