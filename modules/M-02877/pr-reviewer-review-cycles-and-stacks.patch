+                .iter()
+                .filter_map(|node| {
+                    let id = node["comments"]["nodes"][0]["databaseId"].as_u64()?;
+                    Some((id, node["isResolved"].as_bool().unwrap_or(false)))
+                })
+                .collect()
+        })
+        .unwrap_or_default();
+    let next = if threads["pageInfo"]["hasNextPage"].as_bool() == Some(true) {
+        threads["pageInfo"]["endCursor"]
+            .as_str()
+            .map(ToString::to_string)
+    } else {
+        None
+    };
+    Ok((pairs, next))
