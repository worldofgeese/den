+            7,
+            "sha-2",
+            "alice",
+            &stored,
+            &[reworded, original.clone()],
+            &memory,
+            &paths(&["src/fetch.rs"]),
+            None,
+        );
+        assert_eq!(fingerprints[1], original.fingerprint);
+        assert_ne!(fingerprints[0], fingerprints[1]);
+        assert_eq!(delta.still_blocking, 1);
+        assert_eq!(delta.newly_found, 1);
+    }
 }
