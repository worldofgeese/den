+            "only the new nitpick is posted: {comments:?}"
+        );
+        assert_eq!(comments[0]["body"], NITPICK);
+        let body = posted[0]["body"].as_str().unwrap();
+        assert!(
+            body.contains("1 earlier finding is still open in its thread"),
