{gateway, ...}: {
  # pi on the token-saving toolchain, after LEGO/agentic-engineering-community
  # docs/guides/setup-token-saving-toolchain.md. That guide targets Claude
  # Code; every tool also ships a pi integration, which this wires:
  #   1 Caveman     proxy (launchd) + pi extension (through a shim) + skills
  #   2 RTK         rtk's own pi extension, generated by `rtk init --agent pi`
  #   3 ponytail    pi package (extension + skills)
  #   4 Signet      already team Signet (agent-integrations.nix)
  #   5 context-mode pi package (it brings its own MCP bridge)
  #   6 CodeGraph   MCP server
  #
  # A pi request takes the guide's proxy chain, with Caveman's proxy in front
  # (see agentProviders.pi): pi -> Caveman (127.0.0.1:8787, compat mount
  # lego-claude) -> Headroom (darwin.nix) -> the gateway's /claude endpoint.
  # The same Caveman proxy serves the pi extension's tool-output recovery.
  # local-model-proxy and Phoenix are gone (OPERATIONS.md).
  den.aspects.dktaohan.homeManager = {
    pkgs,
    lib,
    config,
    ...
  }: let
    home = config.home.homeDirectory;

    # Caveman's local proxy. Its port is the CLI's and the pi extension's
    # default gateway; headroom's 8787 is container-internal on this host,
    # so the two do not collide.
    cavemanListen = "127.0.0.1:8787";

    # Headroom's loopback URL on this Mac (darwin.nix runs the container).
    headroomUrl = gateway.headroom.loopbackUrl "M-02877";

    # The Caveman CLI and its native binaries come from npm
    # (@caveman-ai/cli, `caveman setup --install`), not Nix: ~/.caveman/bin.
    # Caveman 4 also has `caveman setup` modules (~/.caveman/cloud.json). Run it
    # with `--agents none`: `--agents pi` writes
    # ~/.pi/agent/extensions/caveman-native.js, which loads the extension a
    # second time beside the shim below.
    cavemanCli = "${home}/.local/bin/caveman";
    cavemanExtension = "${home}/.local/lib/node_modules/@caveman-ai/cli/dist/caveman-pi-extension.mjs";

    cavemanProxy = pkgs.writeShellApplication {
      name = "caveman-proxy-serve";
      text = ''
        bin=${lib.escapeShellArg "${home}/.caveman/bin/caveman-proxy"}
        if [ ! -x "$bin" ]; then
          echo "caveman-proxy-serve: $bin missing (run caveman setup --install); retrying" >&2
          sleep 60
          exit 1
        fi
        # The run-state file these write (~/.caveman/run/8787.json) is what the
        # pi extension reads to decide whether to compress:
        # - owner `start` marks a long-lived proxy, not a per-wrap one.
        # - CAVEMAN_RECOVERY=mcp says the agent can expand elided content. True
        #   for pi: the extension registers caveman_retrieve itself.
        # - CAVE_ENGINE_TOON re-encodes uniform JSON as TOON when that is
        #   smaller, as `caveman <agent>` does.
        # - CAVEMAN_LISTEN also stops `caveman setup` from moving the
        #   runtime to another port.
        export CAVEMAN_LISTEN=${cavemanListen}
        export CAVEMAN_PROXY_OWNER=start
        export CAVEMAN_MODE=compress
        export CAVEMAN_RECOVERY=mcp
        export CAVE_ENGINE_TOON=best-of
        # No Caveman cloud features here, telemetry included: `caveman
        # telemetry off` records the choice in ~/.caveman/cloud.json, and
        # DO_NOT_TRACK keeps it off if that file is ever reset.
        export DO_NOT_TRACK=1
        # The lego-claude mount's upstream is Headroom on loopback. Caveman's
        # SSRF guard blocks loopback upstreams unless they are listed
        # (caveman#841), and a blocked request only gets a bare 502
        # cave_upstream_unavailable (caveman#1440).
        export CAVE_SSRF_ALLOWLIST=127.0.0.1
        exec "$bin" serve
      '';
    };

    # Without this file the proxy's anthropic upstream is api.anthropic.com,
    # which would send the LEGO gateway key to Anthropic's public API. No model
    # traffic uses that upstream; it must only be safe. The /claude endpoint
    # is the one that Claude Code uses.
    #
    # pi's model traffic uses the lego-claude compat mount. A compat mount
    # keeps the inbound bearer (caveman#1215), which is the only credential
    # the gateway accepts. It forwards only standard headers, so it names
    # x-headroom-cwd (see agentProviders.pi).
    cavemanConfig = ''
      # Managed by den (modules/M-02877/token-toolchain.nix).
      providers:
        anthropic:
          base_url: ${gateway.claudeUrl}
      compat:
        lego-claude:
          base_url: ${headroomUrl}
          wire_dialect: anthropic
          forward_headers: [x-headroom-cwd]
    '';

    # Loads the npm-installed extension, and degrades to nothing when it is
    # not installed. Caveman 1.x re-registered the provider to route it,
    # which dropped authHeader (401), and this shim used to no-op that; 2.x and
    # 4.0.1 route with pi.setModel instead, and do not route lego-claude at all
    # (see agentProviders.pi). 4.0.1 still ships dist/caveman-pi-extension.mjs.
    cavemanShim = ''
      // Managed by den (modules/M-02877/token-toolchain.nix). Edits are overwritten.
      import { existsSync } from "node:fs";
      import { pathToFileURL } from "node:url";

      const upstream = ${builtins.toJSON cavemanExtension};
      process.env.CAVEMAN_PI_HOOK_CMD ??= JSON.stringify([${builtins.toJSON cavemanCli}]);
      // The hook CLI runs as a child of pi: no Caveman telemetry (no cloud features).
      process.env.DO_NOT_TRACK ??= "1";

      export default async function (pi) {
        if (!existsSync(upstream)) {
          process.stderr.write("caveman: " + upstream + " missing; run `npm install -g @caveman-ai/cli`\n");
          return;
        }
        const { default: caveman } = await import(pathToFileURL(upstream).href);
        return caveman(pi);
      }
    '';

    # rtk ships its pi extension inside the binary; generate it from the same
    # rtk that is installed, so the two never drift.
    rtkPiExtension = pkgs.runCommand "rtk-pi-extension.ts" {} ''
      export HOME=$TMPDIR
      ${lib.getExe pkgs.rtk} init -g --agent pi >/dev/null
      cp "$HOME/.pi/agent/extensions/rtk.ts" "$out"
    '';

    cavemanSkills = ["caveman" "caveman-commit" "caveman-compress" "caveman-help" "caveman-review" "caveman-stats"];
  in {
    agentProviders.pi = {
      # Through the chain: Caveman's lego-claude compat mount, then Headroom,
      # then the gateway. From 2026-10-14 to 2026-11-01 pi went straight to
      # the gateway, for two reasons that are now fixed:
      # - Headroom 0.40.0 re-wrote the prompt cache at each prompt, up to 274k
      #   tokens for one (headroom#4213). 0.41.0 and 0.42.0 keep the cache.
      # - Caveman's built-in anthropic upstream forwarded x-api-key, not the
      #   bearer, so the gateway answered 401 (caveman#1215). A compat mount
      #   keeps the bearer.
      # Measured 2026-11-01 with Headroom 0.42.0 and the bin-v4.0.2 proxy
      # (OPERATIONS.md, "pi through the chain"): the cache holds through both
      # hops, Opus thinking works, and cost is within run-to-run noise of
      # direct.
      #
      # The extension sees that this URL is the proxy itself, so it does not
      # route the provider again ("pass-through ... points at the Caveman
      # proxy itself" at each session start).
      baseUrl = "http://${cavemanListen}/compat/lego-claude";
      headers = {
        # pi sends the key as the bearer and as x-api-key. The empty value
        # keeps the key out of x-api-key; the gateway reads only the bearer.
        "x-api-key" = "";
        # Headroom files memories per project and does not find pi's working
        # directory itself (headroom#4442). pi expands ${PWD} per request.
        "x-headroom-cwd" = "\${PWD}";
      };
    };

    piAgent = {
      packages = [
        # Not npm:ponytail, which is an unrelated package.
        "npm:@dietrichgebert/ponytail@5.3.3"
        "npm:context-mode@1.0.169"
      ];
      # The context-mode package starts its own server.bundle.mjs and registers
      # each tool with pi.registerTool() (its MCP bridge, context-mode#426).
      # A context-mode entry in mcp.json started a second server, and pi got
      # each ctx_* tool twice: once as a tool, once as mcp__context_mode__*
      # (den#55). The package's bash routing hook needs no MCP entry.
      removedMcpServers = ["context-mode"];
      mcpServers = {
        codegraph = {
          command = "/opt/homebrew/bin/codegraph";
          args = ["serve" "--mcp"];
          description = "CodeGraph: symbol-level codebase index";
          # One tool, codegraph_explore. Under pi's default `codemode` exposure
          # the model is never offered it: 0 calls in 60 sessions (den#63).
          exposure = "direct";
        };
        # No Headroom server: pi requests do not pass Headroom, so pi has no
        # Headroom hashes to retrieve.
      };
    };

    home.file = {
      ".caveman/caveman.yaml".text = cavemanConfig;
      ".pi/agent/extensions/caveman.js".text = cavemanShim;
      ".pi/agent/extensions/rtk.ts".source = rtkPiExtension;
    };

    home.activation = {
      # New pi sessions start on lego-claude. Only set when nothing is chosen,
      # so a default picked later in pi is kept; running sessions keep the
      # provider they started with.
      piDefaultProvider = lib.hm.dag.entryAfter ["writeBoundary" "piPackages"] ''
        settings=${lib.escapeShellArg "${home}/.pi/agent/settings.json"}
        if [ -e "$settings" ] && [ -z "$(${lib.getExe pkgs.jq} -r '.defaultProvider // empty' "$settings")" ]; then
          if merged="$(${lib.getExe pkgs.jq} --arg m ${lib.escapeShellArg gateway.modelIds.opus} \
              '.defaultProvider = "lego-claude" | .defaultModel = $m' "$settings")"; then
            if [ -z "''${DRY_RUN:-}" ]; then
              (umask 077 && printf '%s\n' "$merged" >"$settings.hm-tmp") && mv "$settings.hm-tmp" "$settings"
            else
              echo "would set defaultProvider in $settings"
            fi
          fi
        fi
      '';

      # Caveman's skills come from its own installer into ~/.claude/skills;
      # link them for pi rather than copying, so `caveman` updates reach both.
      piCavemanSkills = lib.hm.dag.entryAfter ["writeBoundary"] ''
        for s in ${lib.escapeShellArgs cavemanSkills}; do
          src=${lib.escapeShellArg "${home}/.claude/skills"}/$s
          dst=${lib.escapeShellArg "${home}/.pi/agent/skills"}/$s
          if [ -d "$src" ] && [ ! -e "$dst" ] && [ ! -L "$dst" ]; then
            run mkdir -p ${lib.escapeShellArg "${home}/.pi/agent/skills"}
            run ln -s "$src" "$dst"
          fi
        done
      '';
    };

    launchd.agents.caveman-proxy = {
      enable = true;
      config = {
        Label = "com.dktaohan.caveman-proxy";
        ProgramArguments = ["${cavemanProxy}/bin/caveman-proxy-serve"];
        EnvironmentVariables.HOME = home;
        WorkingDirectory = "${home}/.caveman";
        RunAtLoad = true;
        KeepAlive = true;
        ThrottleInterval = 10;
        ProcessType = "Background";
        StandardOutPath = "${home}/.local/state/caveman-proxy.log";
        StandardErrorPath = "${home}/.local/state/caveman-proxy.log";
      };
    };
  };
}
